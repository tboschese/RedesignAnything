{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "type": "string",
      "enum": [
        "refresh",
        "redesign",
        "reimagine"
      ]
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "capability_id": {
            "type": "string",
            "pattern": "^cap_"
          },
          "target_route": {
            "type": "string"
          },
          "target_component": {
            "type": "string"
          },
          "target_action": {
            "type": "string"
          },
          "decision_id": {
            "type": "string"
          },
          "scenario_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exception_approved": {
            "type": "boolean"
          }
        },
        "required": [
          "capability_id",
          "decision_id",
          "scenario_ids",
          "exception_approved"
        ]
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "capability_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "risks": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "id",
                "description",
                "risks"
              ]
            }
          },
          "chosen_option_id": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "ux_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "feasibility": {
            "type": "string",
            "enum": [
              "ui_only",
              "frontend_orchestration",
              "backend_change_required",
              "not_determined"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "approved",
              "rejected"
            ]
          },
          "approval_evidence_id": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "capability_ids",
          "problem",
          "options",
          "chosen_option_id",
          "rationale",
          "ux_rule_ids",
          "evidence_ids",
          "feasibility",
          "dependencies",
          "status"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://schemas.redesign-anything.example/1.0.0/design-decision.schema.json",
        "title": "design-decision"
      }
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "revision",
    "generated_at",
    "mode",
    "snapshot_id",
    "mappings",
    "unknowns",
    "decisions"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.redesign-anything.example/1.0.0/transformation-plan.schema.json",
  "title": "transformation-plan"
}
